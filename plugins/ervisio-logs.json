{
  "id": "ervisio-logs",
  "repo": "Ervisio/ErvisioLogs",
  "version": "0.1.2",
  "tag": "v0.1.2",
  "asset": "ervisio-logs-0.1.2.tar.gz",
  "upstreamSha256": "7e322d25d596c10f0dfe65800d4f09a09dee3131870f132125b80aff58162954",
  "notes": "Off-site archive on an SFTP server with a password, such as a Hetzner Storage Box. > **Not tried on a host.** The changes passed `go build`, `go vet`, type checks, the plugin and web builds and > `docker compose config`. No SFTP server was reached with them and the plugin was not loaded in Ervisio. Try it on a > test server first. | File | Use | |---|---| | `ervisio-logs-0.1.2-linux-amd64.tar.gz`, `-linux-arm64.tar.gz` | Standalone: binary with the web UI, systemd unit, `install.sh` | | `ervi...",
  "manifest": {
    "name": "Ervisio Logs",
    "author": "Ervisio team",
    "description": "Install and run Ervisio Logs on this server, as a Docker Compose stack (shown in the Docker plugin) or as a systemd service, and publish it through the Caddy you already run. Data is never deleted by the plugin.",
    "homepage": "https://github.com/Ervisio/ErvisioLogs",
    "icon": "server",
    "color": "log",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "docker-check",
          "description": "Show the Docker Compose version (checks that Docker and Compose v2 are available)",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "version",
            "--short"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 30,
          "remote": "docker"
        },
        {
          "name": "stacks-init",
          "description": "Create the shared stacks folder /opt/stacks used by the Docker plugin, writable by the docker group",
          "argv": [
            "install",
            "-d",
            "-m",
            "2775",
            "-g",
            "docker",
            "/opt/stacks"
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "stack-init",
          "description": "Create /opt/stacks/ervisio-logs, closed to users outside the docker group (it holds the stack's .env)",
          "argv": [
            "install",
            "-d",
            "-m",
            "2770",
            "-g",
            "docker",
            "/opt/stacks/ervisio-logs"
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "compose-up",
          "description": "Create or update the Ervisio Logs containers",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "--project-name",
            "ervisio-logs",
            "--project-directory",
            "/opt/stacks/ervisio-logs",
            "-f",
            "/opt/stacks/ervisio-logs/compose.yaml",
            "up",
            "-d",
            "--remove-orphans"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 600,
          "remote": "docker"
        },
        {
          "name": "compose-pull",
          "description": "Pull the Ervisio Logs images",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "--project-name",
            "ervisio-logs",
            "--project-directory",
            "/opt/stacks/ervisio-logs",
            "-f",
            "/opt/stacks/ervisio-logs/compose.yaml",
            "pull"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 600,
          "remote": "docker"
        },
        {
          "name": "compose-down",
          "description": "Stop and remove the Ervisio Logs containers; the volumes and their data stay",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "--project-name",
            "ervisio-logs",
            "--project-directory",
            "/opt/stacks/ervisio-logs",
            "-f",
            "/opt/stacks/ervisio-logs/compose.yaml",
            "down",
            "--remove-orphans"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "remote": "docker"
        },
        {
          "name": "compose-ps",
          "description": "List the Ervisio Logs containers and their health",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "--project-name",
            "ervisio-logs",
            "--project-directory",
            "/opt/stacks/ervisio-logs",
            "-f",
            "/opt/stacks/ervisio-logs/compose.yaml",
            "ps",
            "--all",
            "--format",
            "json"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 30,
          "remote": "docker"
        },
        {
          "name": "compose-logs",
          "description": "Show the last 200 lines of the Ervisio Logs app container",
          "argv": [
            "docker",
            "-H",
            "{env}",
            "compose",
            "--project-name",
            "ervisio-logs",
            "--project-directory",
            "/opt/stacks/ervisio-logs",
            "-f",
            "/opt/stacks/ervisio-logs/compose.yaml",
            "logs",
            "--tail",
            "200",
            "--no-color",
            "migrate",
            "app"
          ],
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 30,
          "remote": "docker"
        },
        {
          "name": "standalone-install",
          "description": "Download the Ervisio Logs release this plugin was built for, check its SHA-256 and run its installer",
          "argv": [
            "bash",
            "/var/lib/ervisio/plugins/ervisio-logs/bin/standalone.sh",
            "install"
          ],
          "admin": true,
          "timeoutSec": 600
        },
        {
          "name": "standalone-uninstall",
          "description": "Remove the Ervisio Logs service and binary; configuration, spool and databases stay",
          "argv": [
            "bash",
            "/var/lib/ervisio/plugins/ervisio-logs/bin/standalone.sh",
            "uninstall"
          ],
          "admin": true,
          "timeoutSec": 120
        },
        {
          "name": "standalone-status",
          "description": "Show the state of the ervisio-logs service",
          "argv": [
            "systemctl",
            "show",
            "ervisio-logs.service",
            "--property=LoadState,ActiveState,SubState,UnitFileState"
          ],
          "timeoutSec": 15
        },
        {
          "name": "standalone-version",
          "description": "Show the installed Ervisio Logs version",
          "argv": [
            "/usr/local/bin/ervisio-logs",
            "version"
          ],
          "timeoutSec": 15
        },
        {
          "name": "standalone-health",
          "description": "Probe http://127.0.0.1:8080/healthz",
          "argv": [
            "/usr/local/bin/ervisio-logs",
            "healthcheck"
          ],
          "timeoutSec": 15
        },
        {
          "name": "standalone-start",
          "description": "Start the ervisio-logs service",
          "argv": [
            "systemctl",
            "start",
            "ervisio-logs.service"
          ],
          "admin": true,
          "timeoutSec": 120
        },
        {
          "name": "standalone-restart",
          "description": "Restart the ervisio-logs service",
          "argv": [
            "systemctl",
            "restart",
            "ervisio-logs.service"
          ],
          "admin": true,
          "timeoutSec": 120
        },
        {
          "name": "standalone-stop",
          "description": "Stop the ervisio-logs service",
          "argv": [
            "systemctl",
            "stop",
            "ervisio-logs.service"
          ],
          "admin": true,
          "timeoutSec": 60
        },
        {
          "name": "standalone-logs",
          "description": "Show the last 200 journal lines of the ervisio-logs service",
          "argv": [
            "journalctl",
            "-u",
            "ervisio-logs.service",
            "-n",
            "200",
            "--no-pager",
            "-o",
            "short-iso"
          ],
          "admin": true,
          "adminUnlessGroup": "systemd-journal",
          "timeoutSec": 30
        },
        {
          "name": "service-show",
          "description": "Read the state of caddy.service, to find the Caddy that serves this machine",
          "argv": [
            "systemctl",
            "show",
            "caddy.service",
            "--no-pager",
            "--property=LoadState,ActiveState,SubState,ExecStart,FragmentPath,UnitFileState"
          ],
          "timeoutSec": 15
        },
        {
          "name": "validate",
          "description": "Check a Caddyfile with caddy validate (in a scratch data folder, so nothing in Caddy's storage changes)",
          "argv": [
            "env",
            "HOME=/run/ervisio-logs-caddy",
            "XDG_DATA_HOME=/run/ervisio-logs-caddy/data",
            "XDG_CONFIG_HOME=/run/ervisio-logs-caddy/config",
            "caddy",
            "validate",
            "--config",
            "{0}",
            "--adapter",
            "caddyfile"
          ],
          "args": [
            {
              "pattern": "/etc/caddy/[A-Za-z0-9._-]{1,100}(/[A-Za-z0-9._-]{1,100})?",
              "maxLen": 220
            }
          ],
          "admin": true,
          "timeoutSec": 60
        },
        {
          "name": "reload",
          "description": "Reload caddy.service after the Ervisio Logs site was added or removed",
          "argv": [
            "systemctl",
            "reload",
            "caddy.service"
          ],
          "admin": true,
          "timeoutSec": 120
        },
        {
          "name": "has-docker",
          "description": "Check whether Docker is installed",
          "argv": [
            "test",
            "-S",
            "/var/run/docker.sock"
          ],
          "timeoutSec": 10
        },
        {
          "name": "user",
          "description": "Read your user name (to know if you can use Docker)",
          "argv": [
            "id",
            "-un"
          ],
          "timeoutSec": 10
        },
        {
          "name": "groups",
          "description": "Read your groups (to know if you can use Docker)",
          "argv": [
            "id",
            "-Gn"
          ],
          "timeoutSec": 10
        },
        {
          "name": "secrets-init",
          "description": "Create /opt/stacks/ervisio-logs/secrets for archive credentials, readable only by the app container user (uid 65532)",
          "argv": [
            "install",
            "-d",
            "-m",
            "0700",
            "-o",
            "65532",
            "-g",
            "65532",
            "/opt/stacks/ervisio-logs/secrets"
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "secrets-install",
          "description": "Move the credentials you entered into /opt/stacks/ervisio-logs/secrets, readable only by the app container user",
          "argv": [
            "install",
            "-m",
            "0400",
            "-o",
            "65532",
            "-g",
            "65532",
            "/opt/stacks/ervisio-logs/.secret-incoming",
            "{0}"
          ],
          "args": [
            {
              "pattern": "/opt/stacks/ervisio-logs/secrets/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}",
              "maxLen": 140
            }
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "secrets-list",
          "description": "List the names of the archive credential files (never their content)",
          "argv": [
            "ls",
            "-1A",
            "/opt/stacks/ervisio-logs/secrets"
          ],
          "admin": true,
          "timeoutSec": 15
        },
        {
          "name": "standalone-secrets-init",
          "description": "Create /etc/ervisio-logs/secrets for archive credentials, readable by the ervisio-logs service",
          "argv": [
            "install",
            "-d",
            "-m",
            "2750",
            "-o",
            "root",
            "-g",
            "ervisio-logs",
            "/etc/ervisio-logs/secrets"
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "standalone-secrets-install",
          "description": "Move the credentials you entered into /etc/ervisio-logs/secrets, readable by the ervisio-logs service",
          "argv": [
            "install",
            "-m",
            "0640",
            "-o",
            "root",
            "-g",
            "ervisio-logs",
            "/etc/ervisio-logs/.secret-incoming",
            "{0}"
          ],
          "args": [
            {
              "pattern": "/etc/ervisio-logs/secrets/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}",
              "maxLen": 130
            }
          ],
          "admin": true,
          "timeoutSec": 30
        },
        {
          "name": "standalone-secrets-list",
          "description": "List the names of the archive credential files (never their content)",
          "argv": [
            "ls",
            "-1A",
            "/etc/ervisio-logs/secrets"
          ],
          "admin": true,
          "timeoutSec": 15
        }
      ],
      "files": {
        "read": [
          {
            "path": "/opt/stacks/ervisio-logs",
            "admin": true,
            "adminUnlessGroup": "docker"
          },
          {
            "path": "/etc/ervisio-logs",
            "admin": true
          },
          "/etc/caddy"
        ],
        "write": [
          {
            "path": "/opt/stacks/ervisio-logs",
            "admin": true,
            "adminUnlessGroup": "docker"
          },
          {
            "path": "/etc/ervisio-logs",
            "admin": true
          },
          {
            "path": "/etc/caddy",
            "admin": true
          },
          {
            "path": "~/.config/ervisio/plugins/ervisio-logs",
            "create": true
          }
        ]
      },
      "http": [
        {
          "name": "docker",
          "socket": "/var/run/docker.sock",
          "admin": true,
          "adminUnlessGroup": "docker",
          "headers": [
            "Content-Type"
          ],
          "maxBody": 8388608,
          "timeoutSec": 120,
          "rules": [
            {
              "methods": [
                "GET"
              ],
              "path": "/version"
            },
            {
              "methods": [
                "GET"
              ],
              "path": "/v1\\.[0-9]+/containers/json"
            },
            {
              "methods": [
                "GET"
              ],
              "path": "/v1\\.[0-9]+/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}/json"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1\\.[0-9]+/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}/(start|exec)"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1\\.[0-9]+/exec/[a-f0-9]{64}/start"
            },
            {
              "methods": [
                "GET"
              ],
              "path": "/v1\\.[0-9]+/exec/[a-f0-9]{64}/json"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1\\.[0-9]+/networks/ervisiologs_edge/connect"
            }
          ]
        }
      ],
      "sockets": [
        "/var/run/docker.sock"
      ]
    },
    "contributes": {
      "pages": [
        {
          "id": "logs",
          "title": "Ervisio Logs",
          "icon": "server"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "wheel",
        "sudo",
        "docker"
      ]
    },
    "minCore": "0.5.0",
    "platforms": [
      "linux"
    ]
  }
}
