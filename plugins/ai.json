{
  "id": "ai",
  "repo": "Ervisio/plugin-ai",
  "version": "0.3.0",
  "tag": "v0.3.0",
  "asset": "ai-0.3.0.tar.gz",
  "upstreamSha256": "7241f55a7e6bab66786a6b49d45adffd3a06921c11f5a2976080d4091fbf0bba",
  "notes": "Persist conversations and settings per account with conflict detection; add the compact global assistant surface and the shared safety-folder chooser. All notable changes to the Ervisio AI plugin will be documented in this file.",
  "manifest": {
    "name": "AI",
    "author": "Ervisio team",
    "description": "Chat with your own API key, or turn this machine into an MCP server that Claude Code, Codex, Cursor, Kilo Code, Antigravity and other tools use from your computer. Full control of the shell, files, services, Docker and Ervisio itself.",
    "homepage": "https://github.com/Ervisio/plugin-ai",
    "icon": "zap",
    "color": "ov",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "args": [
            {
              "maxLen": 32,
              "pattern": "[a-f0-9]{32}"
            }
          ],
          "argv": [
            "python3",
            "-B",
            "/var/lib/ervisio/plugins/ai/engine",
            "call",
            "{0}"
          ],
          "description": "Run one AI tool call (a request file the chat page wrote) as your own user",
          "name": "ai-call",
          "timeoutSec": 600
        },
        {
          "admin": true,
          "args": [
            {
              "maxLen": 32,
              "pattern": "[a-f0-9]{32}"
            }
          ],
          "argv": [
            "python3",
            "-B",
            "/var/lib/ervisio/plugins/ai/engine",
            "call",
            "{0}"
          ],
          "description": "Run one AI tool call as root (needs administrator rights)",
          "name": "ai-root-call",
          "timeoutSec": 600
        },
        {
          "args": [
            {
              "maxLen": 32,
              "pattern": "[a-f0-9]{32}"
            }
          ],
          "argv": [
            "python3",
            "-B",
            "/var/lib/ervisio/plugins/ai/engine",
            "ctl",
            "{0}"
          ],
          "description": "Read the state of the AI server (status, checks, connection details) as your own user",
          "name": "ai-ctl",
          "timeoutSec": 60
        },
        {
          "admin": true,
          "args": [
            {
              "maxLen": 32,
              "pattern": "[a-f0-9]{32}"
            }
          ],
          "argv": [
            "python3",
            "-B",
            "/var/lib/ervisio/plugins/ai/engine",
            "ctl",
            "{0}"
          ],
          "description": "Install, start, stop and configure the headless AI server, its tokens and its safety policy (needs administrator rights)",
          "name": "ai-root-ctl",
          "timeoutSec": 300
        },
        {
          "args": [
            {
              "maxLen": 16,
              "pattern": "tools|whoami|version"
            }
          ],
          "argv": [
            "python3",
            "-B",
            "/var/lib/ervisio/plugins/ai/engine",
            "{0}"
          ],
          "description": "List the AI tools, or say who the engine runs as",
          "name": "ai-info",
          "timeoutSec": 20
        }
      ],
      "files": {
        "write": [
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/ai"
          },
          {
            "admin": true,
            "create": true,
            "path": "/var/lib/ervisio-ai/spool"
          }
        ]
      },
      "network": [
        "api.anthropic.com",
        "api.openai.com",
        "openrouter.ai",
        "generativelanguage.googleapis.com",
        "api.groq.com",
        "api.deepseek.com",
        "api.mistral.ai",
        "api.x.ai"
      ],
      "userHosts": true
    },
    "contributes": {
      "pages": [
        {
          "icon": "zap",
          "id": "ai",
          "title": "AI",
          "ervisios": {
            "view": "ai-ervisios"
          }
        }
      ],
      "snippets": [
        {
          "command": "ervisio-ai status",
          "name": "AI server status"
        },
        {
          "command": "ervisio-ai doctor",
          "name": "AI server checks"
        },
        {
          "command": "ervisio-ai audit --limit 30",
          "name": "What the AI did"
        },
        {
          "command": "tmux -S /var/lib/ervisio-ai/tmux.sock attach",
          "name": "Watch the AI's terminals"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "sudo",
        "wheel",
        "admin"
      ]
    },
    "minCore": "7.0.4"
  }
}
