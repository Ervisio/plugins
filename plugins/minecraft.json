{
  "id": "minecraft",
  "repo": "Ervisio/plugin-minecraft",
  "version": "0.2.1",
  "tag": "v0.2.1",
  "asset": "minecraft-0.2.1.tar.gz",
  "upstreamSha256": "82adfa69f6c7508483f773f1e83a37811146e4082fb0c361c19ae3d543db98a2",
  "notes": "Use the shared file chooser for the Java executable when creating or editing a server.",
  "manifest": {
    "name": "Minecraft",
    "author": "Ervisio team",
    "description": "Manage multiple Java Minecraft servers, console, files, software, add-ons, players, worlds and backups.",
    "homepage": "https://github.com/Ervisio/plugin-minecraft",
    "icon": "server",
    "color": "file",
    "entry": "index.js",
    "capabilities": {
      "http": [
        {
          "name": "minecraft",
          "socket": "/run/ervisio-minecraft/control.sock",
          "admin": true,
          "adminUnlessGroup": "ervisio-minecraft",
          "headers": [
            "Content-Type"
          ],
          "rules": [
            {
              "methods": [
                "GET"
              ],
              "path": "/v1/(health|servers|jobs|activity|catalog/(versions|loaders|addons))"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1/servers"
            },
            {
              "methods": [
                "GET",
                "PATCH",
                "DELETE"
              ],
              "path": "/v1/servers/[a-z0-9-]+"
            },
            {
              "methods": [
                "GET"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(logs|files|file|properties|addons|players|worlds|backups|backup-file|schedules)"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(power|command|files|software|addons|players|worlds|backups)"
            },
            {
              "methods": [
                "PUT"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(file|properties|schedules)"
            },
            {
              "methods": [
                "PATCH"
              ],
              "path": "/v1/servers/[a-z0-9-]+/file"
            }
          ],
          "maxBody": 1048576,
          "timeoutSec": 60
        }
      ],
      "sockets": [
        "/run/ervisio-minecraft/control.sock"
      ]
    },
    "contributes": {
      "pages": [
        {
          "id": "minecraft",
          "title": "Minecraft",
          "icon": "server",
          "ervisios": {
            "view": "minecraft-desktop"
          }
        }
      ],
      "widgets": [
        {
          "id": "servers",
          "title": "Minecraft servers",
          "icon": "server"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "ervisio-minecraft",
        "wheel",
        "sudo",
        "admin"
      ]
    },
    "minCore": "7.0.4"
  }
}
