{
  "id": "minecraft",
  "repo": "Ervisio/plugin-minecraft",
  "version": "0.2.0",
  "tag": "v0.2.0",
  "asset": "minecraft-0.2.0.tar.gz",
  "upstreamSha256": "e27ffe2d1308a7e83ce8439a916f6d96dc861796519942b164a26820b82dbc80",
  "notes": "Add a native ErvisiOS workspace with persistent server navigation, an inline console and direct Files, Software, Add-ons, Players, Worlds, Backups and Schedules views. Preserve the Classic page, existing runtime jobs, power controls and error handling. Require Ervisio 0.7.0 or later and build with plugin SDK 0.4.0 (contract 4). No additional server permissions.",
  "manifest": {
    "name": "Minecraft",
    "author": "Ervisio team",
    "description": "Manage multiple Java Minecraft servers, console, files, software, add-ons, players, worlds and backups.",
    "homepage": "https://github.com/Ervisio/plugin-minecraft",
    "icon": "server",
    "color": "file",
    "entry": "index.js",
    "capabilities": {
      "http": [
        {
          "name": "minecraft",
          "socket": "/run/ervisio-minecraft/control.sock",
          "admin": true,
          "adminUnlessGroup": "ervisio-minecraft",
          "headers": [
            "Content-Type"
          ],
          "rules": [
            {
              "methods": [
                "GET"
              ],
              "path": "/v1/(health|servers|jobs|activity|catalog/(versions|loaders|addons))"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1/servers"
            },
            {
              "methods": [
                "GET",
                "PATCH",
                "DELETE"
              ],
              "path": "/v1/servers/[a-z0-9-]+"
            },
            {
              "methods": [
                "GET"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(logs|files|file|properties|addons|players|worlds|backups|backup-file|schedules)"
            },
            {
              "methods": [
                "POST"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(power|command|files|software|addons|players|worlds|backups)"
            },
            {
              "methods": [
                "PUT"
              ],
              "path": "/v1/servers/[a-z0-9-]+/(file|properties|schedules)"
            },
            {
              "methods": [
                "PATCH"
              ],
              "path": "/v1/servers/[a-z0-9-]+/file"
            }
          ],
          "maxBody": 1048576,
          "timeoutSec": 60
        }
      ],
      "sockets": [
        "/run/ervisio-minecraft/control.sock"
      ]
    },
    "contributes": {
      "pages": [
        {
          "id": "minecraft",
          "title": "Minecraft",
          "icon": "server",
          "ervisios": {
            "view": "minecraft-desktop"
          }
        }
      ],
      "widgets": [
        {
          "id": "servers",
          "title": "Minecraft servers",
          "icon": "server"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "ervisio-minecraft",
        "wheel",
        "sudo",
        "admin"
      ]
    },
    "minCore": "0.7.0"
  }
}
