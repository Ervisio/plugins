      "files": {
        "write": [
          {
            "path": "~/.config/ervisio/plugins/firewall",
            "create": true
          }
        ]
      },
      "notify": true,
      "jobs": [
        {
          "name": "watchdog",
          "description": "Check that a firewall is running and send a notification when its state changes.",
          "timeoutSec": 60,
          "params": [
            {
              "name": "backend",
              "pattern": "ufw|firewalld|nftables|iptables|fail2ban",
              "maxLen": 9,
              "description": "ufw, firewalld, nftables, iptables or fail2ban"
            }
          ],
          "steps": [
            {
              "id": "check",
              "command": "state",
              "args": [
                "{param.backend}"
              ]
            },
            {
              "id": "tell",
              "if": {
                "step": "check",
                "when": "changed"
              },
              "notify": {
                "title": "Firewall {param.backend}: {step.check.stdout}",
                "body": "The {param.backend} firewall is now {step.check.stdout} on this server.",
                "level": "warn",
                "link": "/p/firewall/firewall"
              }
            }
          ]
        }
      ]
    },
