  "notes": "Performance hotfix: remove all automatic SQLite filesystem scans and the eager driver check. Search only one explicitly chosen folder, with a 250 ms / 2,000-entry / 50-result budget and throttled traversal. Existing saved files and folders remain available. Load schema tables only when a database is expanded. Filtering never interrogates collapsed databases. Paginate connection cards and reveal database/table nodes in batches. Remove automatic SQLite table/view row counts, per-database size c...",
  "manifest": {
    "name": "Databases",
    "author": "Ervisio Community",
    "description": "HeidiSQL-style database manager for MySQL, MariaDB, PostgreSQL, SQLite, MongoDB and Redis/Valkey: schema tree, editable data grid with live search and filters, query editor with autocomplete, users and slow query log.",
    "homepage": "https://github.com/Ervisio",
    "icon": "database",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "argv": [
            "python3",
            "/var/lib/ervisio/plugins/database/db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker-users",
          "timeoutSec": 300,
          "argv": [
            "python.exe",
            "C:\\ProgramData\\Ervisio\\data\\plugins\\database\\db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "windows"
          ]
        },
        {
          "name": "db-export-status",
          "description": "Account-owned database export status",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
