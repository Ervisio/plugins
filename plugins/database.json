{
  "id": "database",
  "repo": "Ervisio/plugin-database",
  "version": "1.3.0",
  "tag": "v1.3.0",
  "asset": "database-1.3.0.tar.gz",
  "upstreamSha256": "fdc4f442c7f1b32f860909d50c1c93bab4ca38299b48abdd9ed1235122dcb054",
  "notes": "Add shared SQLite file selection and export destinations: browser download, local folder, SFTP/SMB, HTTP, ErvisioDrive, ErvisioRepo and S3. Optional account-private destination settings; exports never delete old files. All notable changes to the Ervisio Database Plugin will be documented in this file.",
  "manifest": {
    "name": "Databases",
    "author": "Ervisio Community",
    "description": "HeidiSQL-style database manager for MySQL, MariaDB, PostgreSQL, SQLite, MongoDB and Redis/Valkey: schema tree, editable data grid with live search and filters, query editor with autocomplete, users and slow query log.",
    "homepage": "https://github.com/Ervisio",
    "icon": "database",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "argv": [
            "python3",
            "/var/lib/ervisio/plugins/database/db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker-users",
          "timeoutSec": 300,
          "argv": [
            "python.exe",
            "C:\\ProgramData\\Ervisio\\data\\plugins\\database\\db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "windows"
          ]
        },
        {
          "name": "db-export-status",
          "description": "Account-owned database export status",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "status"
          ],
          "timeoutSec": 30,
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-export-remotes",
          "description": "Account-owned database export remotes",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "remotes"
          ],
          "timeoutSec": 30,
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-export-deliver",
          "description": "Account-owned database export deliver",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "deliver",
            "{0}"
          ],
          "timeoutSec": 600,
          "platforms": [
            "linux"
          ],
          "args": [
            {
              "pattern": "^[a-f0-9]{32}$",
              "maxLen": 32
            }
          ]
        }
      ],
      "files": {
        "write": [
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/database"
          },
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/backup/inbox"
          }
        ]
      }
    },
    "contributes": {
      "pages": [
        {
          "id": "database",
          "title": "Databases",
          "icon": "database"
        }
      ],
      "snippets": [
        {
          "name": "Check Database Containers",
          "command": "docker ps --filter 'name=db-'"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "wheel",
        "sudo",
        "docker",
        "docker-users"
      ]
    },
    "minCore": "7.0.4",
    "platforms": [
      "linux",
      "windows"
    ]
  }
}
