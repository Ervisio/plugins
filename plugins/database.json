  "notes": "Run database actions in the verified account-owned virtual environment instead of injecting private drivers into system Python. Old optional system OpenSSL/service_identity packages no longer conflict with the private MongoDB/cryptography drivers. Re-execute before consuming private payload files, using an isolated interpreter and only the signed plugin directory. System packages, databases and account credentials are unchanged. Verify imports using the activated runtime interpreter. Add a re...",
  "manifest": {
    "name": "Databases",
    "author": "Ervisio Community",
    "description": "HeidiSQL-style database manager for MySQL, MariaDB, PostgreSQL, SQLite, MongoDB and Redis/Valkey: schema tree, editable data grid with live search and filters, query editor with autocomplete, users and slow query log.",
    "homepage": "https://github.com/Ervisio",
    "icon": "database",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "argv": [
            "python3",
            "/var/lib/ervisio/plugins/database/db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker-users",
          "timeoutSec": 300,
          "argv": [
            "python.exe",
            "C:\\ProgramData\\Ervisio\\data\\plugins\\database\\db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "windows"
          ]
        }
      ],
      "files": {
        "write": [
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/database"
          }
        ]
      }
    },
    "contributes": {
      "pages": [
        {
          "id": "database",
          "title": "Databases",
          "icon": "database"
        }
      ],
      "snippets": [
        {
