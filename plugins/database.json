{
  "id": "database",
  "repo": "Ervisio/plugin-database",
  "version": "1.2.3",
  "tag": "v1.2.3",
  "asset": "database-1.2.3.tar.gz",
  "upstreamSha256": "b5b31eed34d69f90c98353b2068b13cf9b78b2993d03cdf6ab0de4bbb8fae002",
  "notes": "Fix missing PostgreSQL, MySQL, MongoDB and Redis driver errors with an explicit Prepare drivers action and actionable connection errors. Install SHA-256 pinned binary wheels into an account-local Python runtime, verify imports before/after activation, and preserve previous drivers on failure. System Python and databases are unchanged; SQLite needs no extra drivers. Protect runtime code with account ownership/permissions, Windows token-derived profiles and DACL/reparse checks; never share a us...",
  "manifest": {
    "name": "Databases",
    "author": "Ervisio Community",
    "description": "HeidiSQL-style database manager for MySQL, MariaDB, PostgreSQL, SQLite, MongoDB and Redis/Valkey: schema tree, editable data grid with live search and filters, query editor with autocomplete, users and slow query log.",
    "homepage": "https://github.com/Ervisio",
    "icon": "database",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "argv": [
            "python3",
            "/var/lib/ervisio/plugins/database/db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker-users",
          "timeoutSec": 300,
          "argv": [
            "python.exe",
            "C:\\ProgramData\\Ervisio\\data\\plugins\\database\\db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "windows"
          ]
        }
      ],
      "files": {
        "write": [
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/database"
          }
        ]
      }
    },
    "contributes": {
      "pages": [
        {
          "id": "database",
          "title": "Databases",
          "icon": "database"
        }
      ],
      "snippets": [
        {
          "name": "Check Database Containers",
          "command": "docker ps --filter 'name=db-'"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "wheel",
        "sudo",
        "docker",
        "docker-users"
      ]
    },
    "minCore": "0.6.2",
    "platforms": [
      "linux",
      "windows"
    ]
  }
}
