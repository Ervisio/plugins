{
  "id": "database",
  "repo": "Ervisio/plugin-database",
  "version": "1.4.0",
  "tag": "v1.4.0",
  "asset": "database-1.4.0.tar.gz",
  "upstreamSha256": "10c23439cfd9b91cba8c53ae6406d9021229d348aa65dfe2e01ff7fb0e69ec7b",
  "notes": "Replace truncated SQLite IDs with stable full-path hashes; validate file headers, never create files while opening, preserve SQLite3 filenames and support quoted identifiers, generated columns and index metadata. Add bounded SQLite discovery with configurable scan folders, visible source errors, multiple native service instances and non-default Linux process listener ports. Add a per-account connection library with persistent virtual folders, saved connections, explicit credential retention,...",
  "manifest": {
    "name": "Databases",
    "author": "Ervisio Community",
    "description": "HeidiSQL-style database manager for MySQL, MariaDB, PostgreSQL, SQLite, MongoDB and Redis/Valkey: schema tree, editable data grid with live search and filters, query editor with autocomplete, users and slow query log.",
    "homepage": "https://github.com/Ervisio",
    "icon": "database",
    "entry": "index.js",
    "capabilities": {
      "commands": [
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker",
          "timeoutSec": 300,
          "argv": [
            "python3",
            "/var/lib/ervisio/plugins/database/db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-bridge",
          "description": "Ervisio Database Engine Bridge",
          "admin": true,
          "adminUnlessGroup": "docker-users",
          "timeoutSec": 300,
          "argv": [
            "python.exe",
            "C:\\ProgramData\\Ervisio\\data\\plugins\\database\\db-bridge.py",
            "{0}",
            "{1}"
          ],
          "args": [
            {
              "pattern": "[a-zA-Z0-9_-]+",
              "maxLen": 64
            },
            {
              "pattern": ".*",
              "allowDash": true,
              "maxLen": 4096
            }
          ],
          "platforms": [
            "windows"
          ]
        },
        {
          "name": "db-export-status",
          "description": "Account-owned database export status",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "status"
          ],
          "timeoutSec": 30,
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-export-remotes",
          "description": "Account-owned database export remotes",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "remotes"
          ],
          "timeoutSec": 30,
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "db-export-deliver",
          "description": "Account-owned database export deliver",
          "argv": [
            "/usr/bin/ervisiod",
            "--backup",
            "deliver",
            "{0}"
          ],
          "timeoutSec": 600,
          "platforms": [
            "linux"
          ],
          "args": [
            {
              "pattern": "^[a-f0-9]{32}$",
              "maxLen": 32
            }
          ]
        }
      ],
      "files": {
        "write": [
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/database"
          },
          {
            "create": true,
            "path": "~/.config/ervisio/plugins/backup/inbox"
          }
        ]
      }
    },
    "contributes": {
      "pages": [
        {
          "id": "database",
          "title": "Databases",
          "icon": "database"
        }
      ],
      "snippets": [
        {
          "name": "Check Database Containers",
          "command": "docker ps --filter 'name=db-'"
        }
      ]
    },
    "visibleTo": {
      "groups": [
        "wheel",
        "sudo",
        "docker",
        "docker-users"
      ]
    },
    "minCore": "7.0.4",
    "platforms": [
      "linux",
      "windows"
    ]
  }
}
